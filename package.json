{
  "name": "shopkart",
  "version": "1.0.0",
  "private": true,
  "description": "ShopKart MERN e-commerce platform (frontend + backend)",
  "scripts": {
    "postinstall": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -k -n api,web -c blue,green \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --prefix backend run test",
    "test:coverage": "npm --prefix backend run test:coverage",
    "test:smoke": "node backend/scripts/smoke-phase1.mjs",
    "test:smoke2": "node backend/scripts/smoke-phase2.mjs",
    "test:smoke3": "node backend/scripts/smoke-phase3.mjs",
    "test:all-modes": "node backend/scripts/smoke-all-modes.mjs",
    "migrate:json-to-mongo": "npm --prefix backend run migrate:json-to-mongo"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.10.1"
  }
}
