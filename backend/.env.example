# Server Port & Environment
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# JWT Authentication Secret (Required in production: minimum 32 characters, must not be default)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Storage Backend: Leave empty for embedded JSON store (backend/src/data/store.json)
# Local Replica Set (via docker-compose.mongo.yml): mongodb://localhost:27017/shopkart?replicaSet=rs0&directConnection=true
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopkart?retryWrites=true&w=majority
MONGODB_URI=

# Razorpay Payment Gateway (Optional: sandbox simulation mode when empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Delivery via Resend (Recommended)
RESEND_API_KEY=re_123456789_abcdef
EMAIL_FROM=ShopKart <onboarding@resend.dev>

# Email Delivery via SMTP (Alternative fallback; in development/testing, links are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@shopkart.com

# Rate Limiting Configuration (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
